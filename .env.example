# Copy this file to .env.local and fill in real values:
#   cp .env.example .env.local
# .env.local is git-ignored. Never commit real keys.
# On Vercel, add the same variables under Project Settings > Environment Variables.

# --- Supabase (Dashboard > Project Settings > API Keys) ---
# Project URL, e.g. https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable key (starts with sb_publishable_). Safe in the browser; RLS protects data.
# This replaces the legacy "anon" key (NEXT_PUBLIC_SUPABASE_ANON_KEY). A legacy anon key also works here.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# SERVER ONLY. Secret key (sb_secret_...) or legacy service_role key. Bypasses RLS.
# Only read in src/server/env.ts. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# --- Resend (resend.com > API Keys). SERVER ONLY. Optional until we send email. ---
RESEND_API_KEY=

# --- Upstash Redis (console.upstash.com > your database > REST API). SERVER ONLY. ---
# Optional in local development (rate limiting is skipped). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Daily cron (rent charges). SERVER ONLY. ---
# A long random secret, at least 16 characters (for example: openssl rand -hex 32).
# Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>" to
# /api/cron/rent-charges. If it is empty, the cron route refuses every request.
CRON_SECRET=

# --- App ---
# Public base URL of the app, used for auth redirects and email links.
# Local: http://localhost:3000   Production: https://your-domain
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Testing only. SERVER ONLY. ---
# "true" shows a password sign-in for the demo account made by `pnpm seed:demo`.
# Leave it unset in production once real landlords use the app.
# ENABLE_TEST_LOGIN=true
# Optional. The demo account's email and password (used by the seed script;
# TEST_LOGIN_EMAIL is also the only email the password sign-in accepts).
# TEST_LOGIN_EMAIL=test@rentdesk.test
# TEST_LOGIN_PASSWORD=test@123

# Optional: set to 1 to skip env validation (e.g. CI builds with no real keys).
# SKIP_ENV_VALIDATION=1
